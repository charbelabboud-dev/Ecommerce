# Set these as environment variables in production (Azure, Docker, IIS, etc.)
# ASP.NET Core uses double-underscore for nested config keys.

ConnectionStrings__DefaultConnection=Host=YOUR_HOST;Port=5432;Database=ecommerce_store;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
JwtSettings__Secret=GENERATE_A_STRONG_64_CHAR_RANDOM_SECRET_HERE
JwtSettings__Issuer=EcommerceApi
JwtSettings__Audience=EcommerceClients
JwtSettings__ExpirationHours=8
EmailSettings__SenderEmail=your-email@example.com
EmailSettings__SenderPassword=your-app-password
CorsSettings__AllowedOrigins__0=https://your-storefront.com
CorsSettings__AllowedOrigins__1=https://admin.your-storefront.com
